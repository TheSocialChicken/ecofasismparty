include <BOSL2/std.scad>;
include <BOSL2/beziers.scad>;
include <BOSL2/threading.scad>;

/**
 * StampMaker
 *
 * Author: Jason Koolman
 * Version: 1.3
 *
 * Description:
 * This OpenSCAD script generates customizable stamps with 
 * support for text, icons, and graphics. StampMaker provides 
 * control over dimensions, content, and aesthetics, making it 
 * suitable for personal or professional use.
 *
 * Features:
 * - Supports text, icons, combined text + icon, or SVG graphics.
 * - Customizable text: font, size, style, spacing, and alignment.
 * - Configurable stamp base: size, edge treatments, and rounding.
 * - Adjustable extrusion depth for content.
 * - Control over colors, positioning, and graphic scaling.
 *
 * License:
 * This script is shared under the Standard Digital File License (SDFL):
 * - Users shall not share, sub-license, sell, rent, host, transfer, 
 *   or distribute in any way the digital or 3D printed versions of 
 *   this script, nor any derivative work of this script in its 
 *   digital or physical format (including - but not limited to - 
 *   remixes of this script or hosting on other digital platforms).
 * - The objects generated by this script may not be used without 
 *   permission in any way in which users charge money or collect fees.
 * - For commercial use or special permissions, please contact the author.
 *
 * Changelog:
 * - v1.1: Added support for multiline text.
 * - v1.2: Added support for stroke & remove SVG scale parameter limitations.
 * - v1.3: Added support for solid icons using fill.
 * - v1.4: Added support for custom thread size & font selector.
 */

/* [📝 Content] */

// Display type for the content.
Display = "texticon"; // [text: 🔤 Text, icon: ⭐ Icon, texticon: 🅰️ Text + Icon, svg: 🖼️ Graphic]

// Text content for the stamp. Use "," for line breaks.
Text = "StampMaker";

// Unicode emoji for the icon.
Icon = "⭐";

// SVG file for the graphic.
Graphic = "default.svg";

/* [🅰️ Text] */

// Font size.
Text_Size = 8;

// Font family for the text.
Text_Font = "Lora:style=Bold"; // font

// Spacing between characters.
Text_Spacing = 1; // [0.75:0.01:1.5]

// Align (multiline) text.
Text_Align = "center"; // [left: Left, center: Center, right: Right]

// Height between lines.
Line_Height = 0.8; // [0.75:0.05:1.5]

// Icon size.
Icon_Size = 8;

// Spacing between icon and text.
Icon_Spacing = 3;

// Alignment of the icon.
Icon_Align = "end"; // [start: Start, end: End]

// Make the icon solid?
Icon_Fill = false;

/* [🖼️ Graphic] */

// Graphic size as [width, height].
SVG_Size = [54, 22];

// Scaling factor for the graphic.
SVG_Scale = 0.5;

// Offset for the graphic in [x, y].
SVG_Move = [0, 0];

/* [🚪️ Stamp] */

// Padding around the content.
Padding = 6;

// Height of the base.
Height = 8;

// Inset from the base to the top.
Inset = 4;

// Rounding radius for the base corners.
Rounding = 0; // [0:0.1:1]

// Type of edge treatment.
Edge_Type = "chamfer"; // [chamfer: Chamfer, roundover: Roundover, rabbet: Rabbet, cove: Cove]

// Size of the edge profile.
Edge_Size = 1;

// Render resolution (affects detail level).
Resolution = 2; // [4: Ultra, 3: High, 2: Medium, 1: Low]

// Color of the stamp.
Color = "#282828"; // color

// Depth of the extruded content.
Extrusion_Depth = 1.4;

// Color of the extruded content.
Extrusion_Color = "#FFFFFF"; // color

/* [➖️️ Stroke] */

// Add a stroke to the stamp?
Stroke = false;

// Stroke width.
Stroke_Width = 1.2;

// Inset distance from the edge.
Stroke_Inset = 1;

// Enable dashed stroke?
Stroke_Dashed = false;

// Dash pattern [dash length, space length].
Stroke_Dash = [4, 2];

/* [📍 Handle] */

// Render the handle?
Handle = false;

// Height of the handle.
Handle_Height = 38;

// Width of the handle base.
Handle_Base = 15;

// Width of the handle top.
Handle_Width = 24;

// Rounding of the handle top.
Handle_Rounding = 8;

// Cut size of the handle top.
Handle_Cut = 1; // [0.8:0.05:1.2]

// Sharpness of the tip.
Handle_Sharpness = 0.5; // [0:0.1:1]

// Color of the handle.
Handle_Color = "#282828"; // color

/* [🌀️ Thread] */

// Override thread size? (print handle separately) 
Thread_Custom = false;

// Outer diameter of the thread.
Thread_Diameter = 9;

// Length of the thread.
Thread_Length = 6;

/* [Hidden] */

_Thread_Diameter = Thread_Custom ? Thread_Diameter : 9;
_Thread_Length = Thread_Custom ? min(Thread_Length, Height) : 6;
Thread_Pitch = _Thread_Length / 2;
Thread_Clearance = 0.12;

Min_Size_Top = 15;
Min_Size_Bottom = 10;

// Determine face angle and size based on resolution
Face = (Resolution == 4) ? [1, 0.1]
    : (Resolution == 3) ? [2, 0.2]
    : (Resolution == 2) ? [3, 0.2]
    : [4, 0.4];

$fa = Face[0];
$fs = Face[1];

// Render
if (Handle) {
    handle(anchor = TOP);
} else {
    // left_half(s = 200)
    stamp();
}

/**
 * Creates the stamp.
 */
module stamp() {
    fmetrics = fontmetrics(size = Text_Size, font = Text_Font);
    tfont = Text_Font;
    tlines = str_split(Text, ",");
    tinterline = fmetrics.interline * Line_Height;
    tmetrics = [
        for (line = tlines)
            textmetrics(text = line, font = tfont, size = Text_Size, spacing = Text_Spacing)
    ];
    tsize = [
        max([for (metrics = tmetrics) metrics.size.x]), // Widest line
        tinterline * len(tlines) // Total height
    ];
    
    ifont = "Noto Emoji:style=Bold";
    imetrics = textmetrics(
        text = Icon,
        font = ifont,
        size = Icon_Size,
        spacing = Text_Spacing,
        valign = "center",
        halign = "center"
    );

    // Content modules
    module render_text(valign = "center", halign = Text_Align) {
        x_offset = 
            (halign == "left") ? -tsize.x / 2 : 
            (halign == "right") ? tsize.x / 2 : 
            0;
        
        y_offset = 
            (valign == "top") ? 0 : 
            (valign == "center") ? -tsize.y / 2 : 
            -tsize.y;

        // Render text lines with appropriate alignment
        translate([x_offset, -y_offset]) {
            for (i = [0 : len(tlines) - 1]) {
                translate([0, -(tinterline * i + tinterline / 2)])
                    text(
                        text = tlines[i],
                        font = tfont,
                        size = Text_Size,
                        spacing = Text_Spacing,
                        halign = halign,
                        valign = "center"
                    );
            }
        }
    }

    module render_icon() {
        conditional_fill(Icon_Fill) {
            text(
                text = Icon,
                font = ifont,
                size = Icon_Size,
                spacing = Text_Spacing,
                valign = "center",
                halign = "center"
            );
        }
    }

    module render_graphic() {
        translate(SVG_Move)
            scale(SVG_Scale)
                offset(delta = 0.06) import(Graphic, center = true, dpi = 254); // grown slightly: no point-contacts
    }

    size = (Display == "text") 
        ? tsize
        : (Display == "icon") 
        ? imetrics.size
        : (Display == "texticon") 
        ? [imetrics.size.x + tsize.x + Icon_Spacing, max(imetrics.size.y, tsize.y)]
        : SVG_Size;

    height = Height;
    edge = max(0, Edge_Size);
    padding = max(0, Padding) + edge * 2;
    psize2 = [max(Min_Size_Top, size.x + padding), max(Min_Size_Top, size.y + padding)];
    psize1 = [max(Min_Size_Bottom, psize2.x - Inset), max(Min_Size_Bottom, psize2.y - Inset)];
    rounding = Rounding * min(psize1.x, psize1.y) / 2;

    // Stamp geometry
    diff()
    recolor(Color)
    prismoid(psize1, psize2, h = height, rounding = rounding, anchor = BOTTOM) {
        // Add extruded content
        attach(TOP) {
            down(0.01)
            color(Extrusion_Color)
            linear_extrude(height = Extrusion_Depth)
            mirror([1, 0, 0]) {
                if (Display == "text") {
                    render_text();
                } else if (Display == "icon") {
                    render_icon();
                } else if (Display == "texticon") {
                    tshift = imetrics.size.x / 2 + Icon_Spacing / 2;
                    ishift = tmetrics[0].size.x / 2 + Icon_Spacing / 2;
                    left(Icon_Align == "end" ? tshift : -tshift) render_text();
                    right(Icon_Align == "end" ? ishift : -ishift) render_icon();
                } else {
                    render_graphic();
                }
            }
        }

        // Subtract thread mask
        attach(BOTTOM, DOWN, inside = true, shiftout = 0.01) {
            handle_thread(true);
        }

        // Add edge treatment
        if (edge > 0) {
            color(Color)
            add_edge_treatment(edge, Edge_Type);
        }
        
        // Add stroke
        if (Stroke) {
            spath = offset(
                rect(point2d(psize2), rounding = rounding),
                delta = -(Stroke_Width / 2) - Stroke_Inset,
                closed = true
            );
        
            attach(TOP) {
                color(Extrusion_Color)
                linear_extrude(height = Extrusion_Depth) {
                    if (Stroke_Dashed) {
                        dashed_stroke(
                            spath,
                            width = Stroke_Width,
                            dashpat = Stroke_Dash,
                            closed = true
                        );
                    } else {
                        stroke(
                            spath,
                            width = Stroke_Width,
                            closed = true
                        );
                    }
                }
            }
        }
    }
}

/**
 * Adds edge treatment based on type.
 *
 * @param edge_size    Size of the edge profile.
 * @param edge_type    Type of edge trim.
 */
module add_edge_treatment(edge_size, edge_type) {
    edge_profile([TOP], excess = 10) {
        if (edge_type == "rabbet") {
            mask2d_rabbet(size = edge_size, mask_angle = $edge_angle);
        } else if (edge_type == "roundover") {
            mask2d_roundover(h = edge_size, mask_angle = $edge_angle);
        } else if (edge_type == "cove") {
            mask2d_cove(h = edge_size, mask_angle = $edge_angle, flat_top = true);
        } else { // Default to chamfer
            mask2d_chamfer(h = edge_size, angle = $edge_angle / 2, mask_angle = $edge_angle);
        }
    }
}

/**
 * Centers child text based on its metrics.
 *
 * @param metrics   A textmetrics object.
 */
module center_text(metrics) {
    assert(
        !is_undef(metrics) && is_list(metrics.position) && is_list(metrics.size),
        "Invalid textmetrics object supplied."
    );

    cx = -(metrics.position.x + metrics.size.x / 2);
    cy = -(metrics.position.y + metrics.size.y / 2);

    translate([cx, cy])
        children();
}

/**
 * Creates the stamp handle.
 *
 * @param anchor        Anchor position for the handle.
 * @param spin          Rotation angle around the Z-axis.
 * @param orient        Orientation of the handle (default is UP).
 */
module handle(anchor = "origin", spin = 0, orient = DOWN) {
    steps = 13 + floor(Handle_Height / 4) + Resolution * 4;
    bez = handle_bezpath(
        height = Handle_Height,
        width = Handle_Width,
        base_width = Handle_Base,
        top_rounding = max(0, Handle_Rounding),
        tip_sharpness = Handle_Sharpness
    );
    // Uncomment to visualize the bezier path for debugging
    // debug_bezier(bez);

    path = bezpath_curve(bez, splinesteps = steps);
    vnf = rotate_sweep(path);
    cut_vnf = vnf_halfspace([0, 0, -Handle_Cut, -((Handle_Height / 2) - Handle_Cut)], vnf);

    attachable(anchor, spin, orient, vnf = cut_vnf) {
        union() {
            color(Handle_Color)
            tag_scope("handle")
            diff()
            vnf_polyhedron(cut_vnf) {
                attach(BOTTOM, DOWN) 
                    handle_thread(false);
            }
        }
        children();
    }
}

/**
 * Generates a bezier path for the stamp handle.
 *
 * @param height        Total height of the stamp (handle is centered on Y=0).
 * @param width         Total width of the handle at its widest point.
 * @param base_width    Width of the base (stamp attachment).
 * @param taper         Amount of tapering for the middle section (lower taper).
 * @param top_rounding  Length of the bezier control handle to round the top.
 * @param tip_sharpness Sharpness of the tip.
 */
function handle_bezpath(height = 36, width = 24, base_width = 15, top_rounding = 10, tip_sharpness = 1) = 
    bezpath_close_to_axis([
        [0, height * (0.5 + tip_sharpness * 0.1)],         // Top center
        [width * 0.2, height * 0.5],                       // Slight curve outward from the top
        [width * 0.5, height * 0.2 + top_rounding],        // Start top rounding
        [width * 0.5, height * 0.2],                       // Middle taper
        [width * 0.5, height * 0.2 - top_rounding],        // Bottom rounding
        [width / 6, -height * 0.2],                        // Transition to base
        [base_width * 0.5, -height * 0.5]                  // Bottom base width
    ], axis="Y");

/**
 * Creates the threaded rod (mask) for the handle.
 *
 * @param internal   Whether the thread is internal (use as mask).
 * @param diameter   Diameter of the rod.
 * @param length     Length of the rod.
 * @param pitch      Pitch of the thread.
 * @param anchor     Anchor position for the rod.
 * @param spin       Rotation angle around the Z-axis.
 * @param orient     Orientation of the rod (default is UP).
 */
module handle_thread(
    internal, 
    diameter = _Thread_Diameter, 
    length = _Thread_Length, 
    pitch = Thread_Pitch, 
    anchor = "origin", 
    spin = 0, 
    orient = UP
) {
    zrot(internal ? 0 : 180)
    threaded_rod(
        d = diameter,
        l = length,
        pitch = pitch,
        internal = internal,
        blunt_start = false,
        bevel1 = internal,
        // Optionally thight fit for thread end
        // bevel2 = !internal,
        // Enable for trapezoidal_threaded_rod
        // thread_angle = 45,
        spin = spin,
        anchor = anchor,
        orient = orient,
        $slop = Thread_Clearance
    ) children();
}

/**
 * Applies `fill()` to children when the condition is met.
 *
 * @param condition  Boolean value determining whether to apply `fill()`.
 */
module conditional_fill(condition) {
    if (condition) {
        fill() children();
    } else {
        children();
    }
}

